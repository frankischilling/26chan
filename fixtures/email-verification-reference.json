  "methods": [
    "  private function validate_email($email) {\n    if (!preg_match('/^[^@]+@[^@]+\\.[a-z]+$/', $email)) {\n      $this->error(self::ERR_BAD_EMAIL);\n    }\n    \n    if (strpos($email, '+') !== false) {\n      $this->error(self::ERR_BAD_EMAIL_PLUS);\n    }\n    \n    if (self::VERIFY_EMAIL_DOMAIN) {\n      $flag = false;\n      \n      $domain = explode('@', $email)[1];\n      \n      if (!$domain) {\n        $this->error(self::ERR_BAD_EMAIL);\n      }\n      \n      foreach (self::$allowed_domains as $allowed_domain) {\n        if ($allowed_domain === $domain) {\n          $flag = true;\n          break;\n        }\n      }\n      \n      if (!$flag) {\n        $this->error(self::ERR_BAD_EMAIL_DOMAIN);\n      }\n    }\n    \n    return true;\n  }\n  \n",
    "  private function normalize_gmail_address($email) {\n    list($user, $domain) = explode('@', $email);\n    $user = preg_replace('/\\./', '', $user);\n    return \"$user@$domain\";\n  }\n  \n",
    "  private function get_domain($email) {\n    $parts = explode('@', $email);\n    \n    if (count($parts) !== 2) {\n      return '';\n    }\n    \n    return $parts[1];\n  }\n  \n"
  ],
  "domain_block": "  static $allowed_domains = [\n    'gmail.com',\n    'hotmail.com',\n    'yahoo.com',\n    'proton.me',\n    'protonmail.com',\n    'outlook.com',\n    'live.com',\n    'icloud.com',\n    'yandex.com',\n    'tutanota.com',\n    'tutamail.com',\n    'tuta.io'\n  ];",
