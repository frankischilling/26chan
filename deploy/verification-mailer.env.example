# Root-owned 0600 file for verification-mailer.service only.
VERIFICATION_MAIL_DATABASE_URL=postgresql://board_mailer:REPLACE_MAILER_DATABASE_PASSWORD@127.0.0.1:5432/paperboard
# This is the issuer's mail-encryption key, never its identity or service key.
VERIFICATION_MAIL_KEY=REPLACE_WITH_ISSUER_MAIL_KEY
# A separately operated local relay handles external authenticated/TLS delivery.
VERIFICATION_SMTP_ADDR=127.0.0.1:25
VERIFICATION_PUBLIC_ORIGIN=https://boards.example.net
