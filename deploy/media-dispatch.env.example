# Install as /etc/26chan-dispatch/dispatch.env, root:root mode 0600.
# Set GATEWAY_UID to `id -u board-media-gateway` after validating that the
# dedicated account's shell is /usr/sbin/nologin and its primary GID is nonzero.
# This deliberate placeholder fails startup; it is not a default service UID.
APP_ENV=development
GATEWAY_UID=REPLACE_WITH_VALIDATED_NUMERIC_UID
# Both ExecStart commands forward only APP_ENV and PATH through env -i.
# APP_ENV=production is rejected by both programs; no secret belongs here.
