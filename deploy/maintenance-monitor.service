[Unit]
Description=Board maintenance outcome observer
After=network.target

[Service]
Type=simple
User=board-maintenance-monitor
Group=board-maintenance-monitor
EnvironmentFile=/etc/paperboard/maintenance-monitor.env
ExecStart=/opt/paperboard/board-maintenance-monitor
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
TasksMax=16
CPUQuota=25%
LimitNOFILE=128
LimitCORE=0
ReadOnlyPaths=/var/lib/paperboard/maintenance

[Install]
WantedBy=multi-user.target
