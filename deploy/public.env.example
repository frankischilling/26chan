APP_ENV=production
BIND_ADDR=127.0.0.1:3000
# Required in production. No public TCP listener is opened in proxy mode.
PUBLIC_PROXY_SOCKET=/run/paperboard-public/public.sock
# Replace with the numeric UID of the dedicated Nginx worker account.
PUBLIC_PROXY_UID=33
PUBLIC_ORIGIN=https://boards.example.com
# Optional JSON-only listener. Set both values or omit both.
API_ORIGIN=https://api.example.com
API_BIND_ADDR=127.0.0.1:3003
STAFF_ORIGIN=https://staff.example.com
MEDIA_ORIGIN=https://example.net
MEDIA_ENABLED=false
# Optional secure tripcodes: set TRIPCODE_KEY to 64 private hexadecimal digits
# from 32 random bytes. Keep it stable across restarts; docs/post-identities.md.
# An unset key leaves normal tripcodes enabled and rejects secure tripcodes.
# Optional public/API budgets. Omit these to use the same defaults.
# Bounds and timeout semantics: docs/public-request-limits.md.
PUBLIC_MAX_ACTIVE_REQUESTS=32
PUBLIC_MAX_CONNECTIONS=128
PUBLIC_MAX_HASH_OPERATIONS=4
PUBLIC_MAX_UPLOADS=4
PUBLIC_WRITES_PER_MINUTE=30
PUBLIC_MAX_TRACKED_PEERS=10000
PUBLIC_HANDLER_TIMEOUT_MS=10000
PUBLIC_HEADER_TIMEOUT_MS=10000
PUBLIC_CONNECTION_TIMEOUT_MS=120000
PUBLIC_MAX_RESPONSE_BYTES=33554432
PUBLIC_MAX_RESPONSE_BUFFER_BYTES=134217728
# Set DATABASE_URL in the root-owned service environment file through the secret manager.
# Required login: board_public. Required TLS parameter: sslmode=verify-full.
# This example contains no deployable credentials.
# Public deletion and ID-enabled posting require a private POSTER_ID_KEY of 64 hex digits.
# Generate it independently of TRIPCODE_KEY and keep it stable across restarts/replicas.
# Without it, deletion and /readyz return 503; read-only routes can still run.
# Required in development too; never use a process-random fallback key.
# POSTER_ID_KEY=REPLACE_WITH_64_PRIVATE_HEXADECIMAL_DIGITS
# Geographic flag boards need an operator-maintained GeoIP2/GeoLite2 country file.
# COUNTRY_DATABASE=/etc/paperboard/GeoLite2-Country.mmdb
# Keep it read-only for the public service; replace it and restart to update labels.
