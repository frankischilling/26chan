# Candidate configuration only. Provision both logins and apply migrations first.
STAFF_MODE=production
STAFF_BIND=127.0.0.1:3001
STAFF_ORIGIN=https://staff.example.org
# Server-side inactivity limit, 60..3600 seconds. Omitted value defaults to 900.
STAFF_IDLE_TIMEOUT_SECONDS=900
# Optional secure tripcodes: use the same private key as the public application's
# TRIPCODE_KEY, under this staff-specific variable. Keep it stable across restarts.
# STAFF_TRIPCODE_KEY=REPLACE_WITH_64_PRIVATE_HEXADECIMAL_DIGITS
# Optional ordinary identity sources. Unbadged posting remains unfinished.
# Use the same private key and verified country data as the public application,
# under these staff-specific names. Do not inherit public identity variables.
# STAFF_POSTER_ID_KEY=REPLACE_WITH_64_PRIVATE_HEXADECIMAL_DIGITS
# STAFF_COUNTRY_DATABASE=/etc/26chan/GeoLite2-Country.mmdb
# Optional Linux peer transport: configure both the socket and the dedicated
# nonroot proxy worker UID. See docs/staff-posting-authority.md and the drop-in.
# STAFF_PROXY_SOCKET=/run/board-staff/staff.sock
# STAFF_PROXY_UID=REPLACE_WITH_STAFF_PROXY_WORKER_UID
PUBLIC_ORIGIN=https://boards.example.org
MEDIA_ORIGIN=https://images.example.net
AUTH_DATABASE_URL=postgres://board_auth:REPLACE_FROM_SECRET_STORE@db.example.org/imageboard?sslmode=verify-full
STAFF_DATABASE_URL=postgres://board_staff:REPLACE_FROM_SECRET_STORE@db.example.org/imageboard?sslmode=verify-full
# Never include MIGRATION_DATABASE_URL, DATABASE_URL, MEDIA_DATABASE_URL or MEDIA_READ_DATABASE_URL here.
