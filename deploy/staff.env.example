# Candidate configuration only. Provision both logins and apply migrations first.
STAFF_MODE=production
STAFF_BIND=127.0.0.1:3001
STAFF_ORIGIN=https://staff.example.org
# Server-side inactivity limit, 60..3600 seconds. Omitted value defaults to 900.
STAFF_IDLE_TIMEOUT_SECONDS=900
PUBLIC_ORIGIN=https://boards.example.org
MEDIA_ORIGIN=https://images.example.net
AUTH_DATABASE_URL=postgres://board_auth:REPLACE_FROM_SECRET_STORE@db.example.org/imageboard?sslmode=verify-full
STAFF_DATABASE_URL=postgres://board_staff:REPLACE_FROM_SECRET_STORE@db.example.org/imageboard?sslmode=verify-full
# Never include MIGRATION_DATABASE_URL, DATABASE_URL or MEDIA_DATABASE_URL here.
